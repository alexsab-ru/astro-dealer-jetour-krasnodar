---
import Layout from '@/layouts/Layout.astro';
import Banner from '@/components/Banner/Banner.astro';
import SpecialSalonsInfo from '@/components/SpecialSalonsInfo.astro';
import AdvantagesList from '@/components/Advantages/List.astro';
import Button from '@/components/Button/Button.astro';
import Faq from '@/components/Faq/Index.astro';
import settings from '@/data/site/settings.json';
import modelsData from '@/data/site/models.json';
const { brand, legal_city_where } = settings;
const { models } = modelsData;
const modelLinks = models.filter(model => model.show).map(m => (`<a href=\"/models/${m.id}/\" class=\"underline text-accent-500 uppercase whitespace-nowrap\">${m.mark_id} ${m.name}</a>`));

const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/jetour/insurance/banner_desktop.webp",
	"mobileImageUrl": "https://cdn.alexsab.ru/pages/jetour/insurance/banner_mobile.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">Страхование JETOUR</span></li></ol></nav><h1>Страхование JETOUR</h1>",
    "descr": ""
};
const advantages = [ 
    {iconName: 'mdi:check-decagram', iconColor: 'text-accent-500', title: 'Уникальные условия', text: 'Привлекательные условия для покупателей и владельцев автомобилей JETOUR от наших страховых партнеров.'},
    {iconName: 'mdi:text-search', iconColor: 'text-accent-500', title: 'Удобство', text: 'Возможность выбрать наиболее подходящий для вас страховой тариф и условия.'},
    {iconName: 'mdi:clock-time-nine-outline', iconColor: 'text-accent-500', title: 'Всегда на связи', text: 'Круглосуточная информационная служба поддержки'}
];
const items = [
    {
        "id": 1,
        "question": "Подробная информация",
        "answer": "Предложение носит информационный характер, не является исчерпывающим и не является публичной офертой (ст.437 ГК РФ). Заключение договора страхования (полиса) не является обязательным условием приобретения автомобиля. Решение о заключении договора страхования принимается по соглашению сторон. <br/><br/>Подробные условия предложения, правила страхования и иные условия уточняйте у сотрудников в официальных дилерских центрах JETOUR.",
        "open": true
    },
    {
        "id": 2,
        "question": "Ренессанс Страхование",
        "answer": "Лицензия ПАО «Группа Ренессанс Страхование» СИ №1284 ",
        "open": false
    },
    {
        "id": 3,
        "question": "Страховой Дом ВСК",
        "answer": "Лицензия САО «ВСК» СИ №0621",
        "open": false
    },
    {
        "id": 4,
        "question": "РЕСО-Гарантия",
        "answer": "Лицензия СИ № 1209 от 22.02.2022 <br/><br/>Условия страхования изложены в Правилах страхования, размещённых на сайте www.reso.ru",
        "open": false
    },
    {
        "id": 5,
        "question": "АльфаСтрахование",
        "answer": "Лицензия АО «АльфаСтрахования» СИ № 2239 от 13.11.2017",
        "open": false
    },
    {
        "id": 6,
        "question": "АСТ",
        "answer": "Лицензия ООО «Страховые брокеры «АСТ» СБ № 4094 от 16.08.2021",
        "open": false
    },
];
---

<Layout title={`Страхование JETOUR`} description={`Официальный дистрибьютор JETOUR в ${legal_city_where} предлагает клиентам выгодные программы страхования. ➤ Специальные условия страхования КАСКО. ➤ Рассчитайте стоимость ОСАГО И КАСКО на ваш автомобиль!`} image="https://cdn.alexsab.ru/pages/jetour/insurance/banner_desktop.webp">
	<Banner banners={[banner]} />
    
    <section class="content">
        <div class="container">
            <div class="text-center space-y-5 mb-10">
                <h2 class="uppercase">Преимущества</h2>
                <p class="max-w-3xl w-full mx-auto">Чтобы обеспечить максимальную безопасность вашего автомобиля JETOUR, мы предоставляем уникальные условия по программе страхования КАСКО вместе с ведущими страховыми партнерами.</p>
            </div>
            <AdvantagesList items={advantages} />
        </div>
    </section>    

    <section class="content bg-gray-100">
        <div class="container">
            <div class="text-center space-y-5 mb-16">
                <h2 class="uppercase">Страховые партнёры</h2>
            </div>
            <div class="flex flex-wrap gap-y-10 items-center justify-center gap-6 sm:gap-10">
                <img src="https://cdn.alexsab.ru/logo/banks/renessans2.webp" alt="" class="w-1/3 md:w-1/6 h-auto">
                <img src="https://cdn.alexsab.ru/logo/banks/vsk2.webp" alt="" class="w-1/3 md:w-1/6 h-auto">
                <img src="https://cdn.alexsab.ru/logo/banks/reso2.webp" alt="" class="w-1/3 md:w-1/6 h-auto">
                <img src="https://cdn.alexsab.ru/logo/banks/al-fa2.webp" alt="" class="w-1/3 md:w-1/6 h-auto">
                <img src="https://cdn.alexsab.ru/logo/banks/ast8.webp" alt="" class="w-1/3 md:w-1/6 h-auto">
            </div>
        </div>
    </section>  

    <section class="content">
        <div class="container">
            <div class="text-center space-y-5 mb-16">
                <h2 class="uppercase">Узнайте стоимость страхования автомобиля и оформите полис онлайн</h2>
            </div>
            <div class="grid lg:grid-cols-2 gap-6 sm:gap-10">
                <div class="bg-gray-100 rounded-3xl py-8 px-5 text-center">
                    <h3 class="!mb-8">Рассчитайте стоимость ОСАГО на ваш автомобиль</h3>
                    <Button 
                        classes="popup-link btn !no-underline" 
                        view="popup-link"
                        url="#common-modal"
                        title="Рассчитать"
                        dataTitle="Рассчитать стоимость ОСАГО"
                        dataFormName="Рассчитать стоимость ОСАГО"
                    />
                </div>
                <div class="bg-gray-100 rounded-3xl py-8 px-5 text-center">
                    <h3 class="!mb-8">Рассчитайте стоимость КАСКО на ваш автомобиль</h3>
                    <Button 
                        classes="popup-link btn !no-underline" 
                        view="popup-link"
                        url="#common-modal"
                        title="Рассчитать"
                        dataTitle="Рассчитать стоимость КАСКО"
                        dataFormName="Рассчитать стоимость КАСКО"
                    />
                </div>
            </div>
        </div>
    </section>    

    <Faq items={items} />

    <section class="content">
        <div class="container">
            <SpecialSalonsInfo title="Узнать подробнее" dataTitle="Узнать подробнее" dataFormName="Узнать подробнее. Страхование JETOUR" />
        </div>
    </section>

</Layout>